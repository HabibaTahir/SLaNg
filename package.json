{
  "name": "slangmath",
  "version": "1.1.2",
  "description": "Saad's Language for Analytical Numerics and Geometry — advanced symbolic mathematics, calculus, ODE/PDE solvers, linear algebra, statistics, and complex analysis. Zero dependencies. Pure JavaScript.",
  "type": "module",
  "main": "./main.js",
  "types": "./slang-math.d.ts",
  "exports": {
    ".": "./main.js",
    "./basic": "./src/core/basic.js",
    "./symbolic": "./src/symbolic.js",
    "./advanced": "./src/core/advanced.js",
    "./ode": "./src/math/ode.js",
    "./linalg": "./src/math/linalg.js",
    "./stats": "./src/math/stats.js",
    "./complex": "./src/core/complex.js",
    "./helpers": "./src/utils/helpers.js",
    "./convertor": "./src/convertor.js",
    "./extended": "./src/extended.js",
    "./cache": "./src/utils/cache.js",
    "./errors": "./src/utils/errors.js",
    "./src/*": "./src/*"
  },
  "scripts": {
    "test": "node --experimental-vm-modules node_modules/.bin/jest"
  },
  "keywords": [
    "math",
    "calculus",
    "symbolic",
    "mathematics",
    "algebra",
    "ode",
    "pde",
    "differential-equations",
    "linear-algebra",
    "statistics",
    "probability",
    "complex-analysis",
    "fft",
    "quaternion",
    "polynomial",
    "latex",
    "numerical-methods"
  ],
  "author": "Muhammad Saad Amin — @SENODROOM",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/SENODROOM/SLaNg.git"
  },
  "bugs": {
    "url": "https://github.com/SENODROOM/SLaNg/issues"
  },
  "homepage": "https://github.com/SENODROOM/SLaNg#readme"
}